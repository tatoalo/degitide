DEGITIDE_IMAGE=ghcr.io/tatoalo/degitide/server:latest
# GHCR images published by .github/workflows/publish-images.yml.
# Copy this file to .env.
DEGITIDE_APP_IMAGE=ghcr.io/tatoalo/degitide/app:latest
DEGITIDE_DASHBOARD_GATEWAY_IMAGE=ghcr.io/tatoalo/degitide/dashboard-gateway:latest
DEGITIDE_WORKER_IMAGE=ghcr.io/tatoalo/degitide/worker:latest
DEGITIDE_EGRESS_PROXY_IMAGE=ghcr.io/tatoalo/degitide/egress-proxy:latest
DEGITIDE_BOOTSTRAP_IMAGE=ghcr.io/tatoalo/degitide/bootstrap:latest
DEGITIDE_USE_PREBUILT=true

# Required when an HTTPS reverse proxy preserves this public Host header.
# DEGITIDE_ALLOWED_HOSTS=127.0.0.1,localhost,[::1],portfolio.example.org
